{
  "schema_version": 1,
  "release_id": "PUBLIC20261104.1",
  "id": "A01",
  "label": "01 来源分析",
  "family": "a",
  "goal": "结合本次买量目标选定参考范围，以原片事实和简短参考判断交A02；分类不作门槛",
  "depends_on": [],
  "environment": [
    "douyin-video",
    "ffprobe／已有转写工具"
  ],
  "references": [
    "main.20",
    "main.21",
    "main.84",
    "reference-scope.01"
  ],
  "conditional_reads": {
    "gui-failure": {
      "when": "同一GUI目标失败或用户质疑当前操作路径",
      "policy_ids": [
        "main.06"
      ]
    },
    "console-write": {
      "when": "即将写入项目业务正文、图片或修改控制台格式",
      "policy_ids": [
        "console-format.01",
        "console-format.02",
        "console-format.03",
        "console-format.04",
        "main.72",
        "console-format.05",
        "console-format.06"
      ]
    },
    "asset-archive": {
      "when": "用户已要求归档、挂载或修复资产入口",
      "policy_ids": [
        "asset-bridge.01",
        "asset-bridge.02",
        "asset-bridge.03",
        "asset-bridge.04",
        "asset-bridge.05",
        "asset-bridge.06"
      ]
    },
    "ip-source": {
      "when": "查找火影原有资产或核对角色时期服装",
      "policy_ids": [
        "main.07"
      ]
    },
    "nonpaid-previs": {
      "when": "只审查已有产物或用户禁止新增费用",
      "policy_ids": [
        "main.02"
      ]
    },
    "new-project": {
      "when": "经核对确属新项目，才读取建项规则",
      "policy_ids": [
        "main.03",
        "main.42",
        "main.43",
        "main.44",
        "main.45",
        "main.46",
        "main.47",
        "main.48",
        "main.94",
        "main.50",
        "main.51",
        "main.52",
        "main.53",
        "main.54"
      ]
    },
    "authorized-collaboration": {
      "when": "本次有明确的跨会话／子Agent协作安排",
      "policy_ids": [
        "main.17"
      ]
    },
    "asset-cleanup": {
      "when": "用户明确要求整理／清理，先完整性对照",
      "policy_ids": [
        "cleanup.01",
        "cleanup.02",
        "cleanup.03",
        "cleanup.04",
        "cleanup.05",
        "cleanup.06",
        "cleanup.07",
        "cleanup.08",
        "cleanup.09",
        "cleanup.10",
        "cleanup.11",
        "main.86"
      ]
    },
    "legacy-case-review": {
      "when": "明确复现历史案例或排查对应旧项目",
      "policy_ids": [
        "character-format.09"
      ]
    }
  },
  "read": [
    "当前项目/用户范围、原片链接或已核验原件、来源与实际时长；A+B另读已选B真实时长"
  ],
  "deliver": [
    "原片、来源与实际规格；初步分段及选段起止、选择依据",
    "第一层原片事实短表：时间、具体事件、必要人物关系／动作、关键对白／画面字、相关声音与实际变化／结果；单句动作只记实际内容，未知就地标注，不要求四张表或每格填满",
    "第二层三条简短参考判断：吸引点、成立机制、迁移价值／边界（含暂定用途）；可合并或标不适用，推断／建议和未知分开，效果未验证；不提前编具体新增角色对白、反转或完整剧本",
    "同版选段证据及必要上下文边界交A02；不在A01改编或单独请求第一次确认"
  ],
  "gate": [
    {
      "id": "A01.G01",
      "criterion": "来源可追溯且真实文件可读",
      "evidence_required": true
    },
    {
      "id": "A01.G02",
      "criterion": "原片事实、参考判断（推断／建议，未验证效果）与未知分开；必要上下文有据，未提前具体创作，分类不充当效果证明",
      "evidence_required": true
    },
    {
      "id": "A01.G03",
      "criterion": "先粗览分段再按本次目标选段；跨界对白动作已局部复核，粗览未冒称完整核验；仅明确要求完整故事／攻略时验相应完整性，分类不清不阻塞",
      "evidence_required": true
    }
  ],
  "after_pass": {
    "next_node": "A02",
    "writeback": "复核实际制品／审核／采用后更新唯一项目Sheet；状态同步沿workflow_state，不自动推进",
    "automatic_side_effects": false
  },
  "failure": {
    "resume": "回最近实际错误来源，修复后仅复验受影响下游",
    "unknown_external_result": "只读回查原任务／上传，不重新提交",
    "blocked_scope": "只阻塞依赖缺项的动作，独立非付费准备继续"
  },
  "execution_kind": "source",
  "shared": [
    "shared/guards.md"
  ],
  "gate_pass_inferred": false,
  "contract_schema_version": 2,
  "gate_schema_version": 1,
  "input_requirements": [
    {
      "id": "A01.I01",
      "description": "当前项目/用户范围、原片链接或已核验原件、来源与实际时长；A+B另读已选B真实时长",
      "required": true,
      "integrity": "sha256_if_file"
    }
  ],
  "source_review_sequence": [
    {
      "id": "acquire",
      "scope": "source_file_metadata"
    },
    {
      "id": "coarse_segment",
      "scope": "source_overview_not_full_verification"
    },
    {
      "id": "select_range",
      "scope": "task_relevant_range_including_line_or_action; complete_story_only_when_required; real_B_reservation_if_ab"
    },
    {
      "id": "detail_selected",
      "scope": "selected_range_facts_and_brief_reference_judgments_as_needed"
    },
    {
      "id": "handoff_A02",
      "scope": "same_selected_range_facts_unknowns_and_brief_judgments_no_concrete_adaptation_no_individual_review"
    }
  ],
  "actions": [
    "按作品ID复用已核原件，否则调用seedance-douyin-video采集；结合本次目标粗览分段、定范围、详核选段，方法见reference-scope.01",
    "参考判断与待核项沿既有交接正文及selected中uncertainties传递；复用已有证据，不新增强制字段、模型调用、安装或重复转写；仅要求拆解时止于此"
  ],
  "skill_calls": [
    {
      "skill": "seedance-douyin-video",
      "when": "获取原片、选段事实提取；ASR／字幕／BGM仅有实际需要时"
    }
  ]
}
