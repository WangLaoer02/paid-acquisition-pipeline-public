{
  "manifestVersion": 5,
  "id": "com.yue.paidskit.premierebridge",
  "name": "Paid Skit Premiere Bridge",
  "version": "0.2.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "paidSkitBridge",
      "label": {
        "default": "Paid Skit Premiere Bridge"
      },
      "minimumSize": {
        "width": 280,
        "height": 160
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 220
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 240
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
